{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-07_monthly_balance_schema.json",
  "title": "Monthly balance projection (C-06)",
  "version": "1.0.0",
  "type": "array",
  "items": { "$ref": "#/$defs/AccountTimeline" },
  "$defs": {
    "AccountTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "iban", "currency", "timeline"],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "iban": { "type": "string" },
        "currency": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "month",
              "inflow_count",
              "inflow_total",
              "outflow_count",
              "outflow_total",
              "net",
              "running_balance"
            ],
            "properties": {
              "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
              "inflow_count": { "type": "integer", "minimum": 0 },
              "inflow_total": { "type": "string" },
              "outflow_count": { "type": "integer", "minimum": 0 },
              "outflow_total": { "type": "string" },
              "net": { "type": "string" },
              "running_balance": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
