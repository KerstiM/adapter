{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-01_sv_schema.json",
  "title": "SVBundle v1",
  "type": "object",
  "required": ["sv_schema_version", "run", "accounts"],
  "properties": {
    "sv_schema_version": { "type": "string", "minLength": 1 },

    "run": {
      "type": "object",
      "required": [
        "run_id",
        "created_at_utc",
        "adapter_version",
        "mapping_version",
        "ruleset_version",
        "source"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 },
        "ruleset_version": { "type": "string", "minLength": 1 },

        "source": {
          "type": "object",
          "required": ["source_type", "source_refs", "period"],
          "properties": {
            "source_type": { "type": "string", "minLength": 1 },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["ref_type", "ref"],
                "properties": {
                  "ref_type": { "type": "string", "minLength": 1 },
                  "ref": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "period": {
              "type": "object",
              "required": ["from_utc", "to_utc"],
              "properties": {
                "from_utc": { "type": ["string", "null"], "format": "date-time" },
                "to_utc": { "type": ["string", "null"], "format": "date-time" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Account" }
    }
  },

  "$defs": {
    "Account": {
      "type": "object",
      "required": ["account_id", "account_ref", "statement_period", "transactions"],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },

        "account_ref": {
          "type": "object",
          "required": ["iban", "currency"],
          "properties": {
            "iban": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$" },
            "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
          },
          "additionalProperties": false
        },

        "statement_period": {
          "type": "object",
          "required": ["from_utc", "to_utc"],
          "properties": {
            "from_utc": { "type": ["string", "null"], "format": "date-time" },
            "to_utc": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": false
        },

        "balances": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["balance_type", "time_utc", "amount", "currency"],
            "properties": {
              "balance_type": { "type": "string", "minLength": 1 },
              "time_utc": { "type": ["string", "null"], "format": "date-time" },
              "amount": { "type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$" },
              "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
            },
            "additionalProperties": false
          }
        },

        "transactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/SVTransaction" }
        },

        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },

    "SVTransaction": {
      "type": "object",
      "required": [
        "record_id",
        "account_id",
        "booking_time_utc",
        "amount",
        "currency",
        "direction",
        "description_norm",
        "counterparty",
        "origin",
        "flags"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },

        "status": { "type": ["string", "null"], "enum": ["BOOKED", "PENDING", null] },

        "booking_time_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "value_time_utc": { "type": ["string", "null"], "format": "date-time" },

        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "description": "Signed decimal string; DEBIT negative, CREDIT positive"
        },

        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "direction": { "type": "string", "enum": ["DEBIT", "CREDIT"] },

        "description_norm": { "type": "string" },
        "description_raw": { "type": ["string", "null"] },

        "remittance": {
          "type": ["object", "null"],
          "properties": {
            "unstructured": { "type": ["string", "null"] },
            "structured": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },

        "transaction_code": { "type": ["string", "null"] },

        "counterparty": {
          "type": "object",
          "required": ["name", "iban", "bic"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "iban": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$" },
            "bic": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{8}([A-Z0-9]{3})?$" }
          },
          "additionalProperties": false
        },

        "origin": {
          "type": "object",
          "required": ["source_format", "source_record_id", "source_lineage"],
          "properties": {
            "source_format": { "type": "string", "minLength": 1 },
            "source_record_id": { "type": "string", "minLength": 1 },
            "source_lineage": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },

        "flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
