{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/S-01_sv_schema.json",
  "title": "SVBundle",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "accounts",
    "transactions"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "created_at_utc",
        "profile_id",
        "spec_versions"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "profile_id": {
          "type": "string"
        },
        "spec_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "S-00A",
            "S-00B",
            "S-01",
            "C-01",
            "R-01",
            "C-02",
            "C-03"
          ],
          "properties": {
            "S-00A": {
              "type": "string"
            },
            "S-00B": {
              "type": "string"
            },
            "S-01": {
              "type": "string"
            },
            "C-01": {
              "type": "string"
            },
            "R-01": {
              "type": "string"
            },
            "C-02": {
              "type": "string"
            },
            "C-03": {
              "type": "string"
            }
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account_id",
          "iban",
          "currency"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "iban": {
            "type": "string",
            "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "account_id",
          "status",
          "value_date",
          "booking_date",
          "amount",
          "direction",
          "counterparty",
          "remittance",
          "flags",
          "source"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "transaction_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "account_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "PENDING",
              "INFORMATION"
            ]
          },
          "booking_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "value_date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currency",
              "raw",
              "signed",
              "abs"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "raw": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,3})?$"
              },
              "signed": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,3})?$"
              },
              "abs": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,3})?$"
              }
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "IN",
              "OUT"
            ]
          },
          "counterparty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "name",
              "iban"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "CREDITOR",
                  "DEBTOR",
                  "UNKNOWN"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "iban": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$"
              }
            }
          },
          "remittance": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "severity",
                "message"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "INFO",
                    "WARN",
                    "ERROR"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_file",
              "input_path"
            ],
            "properties": {
              "input_file": {
                "type": "string"
              },
              "input_path": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}