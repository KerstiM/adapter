{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/S-00C_berlin_standing_orders.schema.json",
  "version": "1.0.0",
  "title": "Berlin Group AIS - Read Standing Orders (minimal subset)",
  "version": "1.0.0",
  "$ref": "#/$defs/ReportResponse",
  "$defs": {
    "Iban": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$"
    },
    "IsoDate": {
      "type": "string",
      "format": "date"
    },
    "Amount": {
      "type": "object",
      "required": [
        "currency",
        "amount"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,3})?$"
        }
      },
      "additionalProperties": true
    },
    "StandingOrderEntry": {
      "type": "object",
      "required": [
        "transactionAmount"
      ],
      "anyOf": [
        { "required": ["valueDate"] },
        { "required": ["nextExecutionDate"] }
      ],
      "properties": {
        "transactionId": {
          "type": "string"
        },
        "creditorName": {
          "type": "string"
        },
        "creditorAccount": {
          "type": "object",
          "properties": {
            "iban": {
              "$ref": "#/$defs/Iban"
            }
          },
          "additionalProperties": true
        },
        "debtorName": {
          "type": "string"
        },
        "debtorAccount": {
          "type": "object",
          "properties": {
            "iban": {
              "$ref": "#/$defs/Iban"
            }
          },
          "additionalProperties": true
        },
        "transactionAmount": {
          "$ref": "#/$defs/Amount"
        },
        "valueDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "nextExecutionDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "remittanceInformationUnstructured": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ReportResponse": {
      "type": "object",
      "required": [
        "account",
        "transactions"
      ],
      "properties": {
        "account": {
          "type": "object",
          "required": ["iban"],
          "properties": {
            "iban": {
              "$ref": "#/$defs/Iban"
            }
          },
          "additionalProperties": true
        },
        "transactions": {
          "type": "object",
          "required": ["information"],
          "properties": {
            "information": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StandingOrderEntry"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
