{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/S-00_berlin_accounts.schema.json",
  "title": "Berlin Group AIS - Read Account List (minimal subset)",
  "type": "object",
  "required": [
    "accounts"
  ],
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resourceId",
          "iban",
          "currency"
        ],
        "properties": {
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "iban": {
            "type": "string",
            "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "product": {
            "type": "string"
          },
          "cashAccountType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "_links": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}