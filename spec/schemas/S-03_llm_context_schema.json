{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/S-03_llm_context_schema.json",
  "version": "1.0.0",
  "title": "LLM context (v1.0.0)",
  "description": "Single context object for one account, or array of context objects for multi-account datasets.",
  "oneOf": [
    { "$ref": "#/$defs/LLMContext" },
    {
      "type": "array",
      "items": { "$ref": "#/$defs/LLMContext" },
      "minItems": 1
    }
  ],
  "$defs": {
    "LLMContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta",
        "tx"
      ],
      "properties": {
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "created_at_utc",
            "account_id",
            "iban",
            "currency"
          ],
          "properties": {
            "run_id": {
              "type": "string"
            },
            "created_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "iban": {
              "type": "string",
              "pattern": "^[A-Z]{2}[0-9A-Z]{13,32}$"
            },
            "account_id": {
              "type": "string"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "tx": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "d",
              "s",
              "dir",
              "a",
              "c"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "d": {
                "type": "string",
                "format": "date"
              },
              "s": {
                "type": "string",
                "enum": [
                  "BOOKED",
                  "PENDING"
                ]
              },
              "dir": {
                "type": "string",
                "enum": [
                  "IN",
                  "OUT"
                ]
              },
              "a": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,3})?$"
              },
              "c": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "cp": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "r": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
