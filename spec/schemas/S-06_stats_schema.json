{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-06_stats_schema.json",
  "title": "Statistics projection (C-05)",
  "version": "1.0.0",
  "type": "array",
  "items": { "$ref": "#/$defs/AccountStats" },
  "$defs": {
    "AccountStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "iban",
        "currency",
        "period",
        "transaction_count",
        "inflow",
        "outflow",
        "top_counterparties"
      ],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "iban": { "type": "string" },
        "currency": { "type": "string" },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "format": "date" },
            "to": { "type": "string", "format": "date" }
          }
        },
        "transaction_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["booked", "pending", "total"],
          "properties": {
            "booked": { "type": "integer", "minimum": 0 },
            "pending": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "inflow": { "$ref": "#/$defs/FlowSummary" },
        "outflow": { "$ref": "#/$defs/FlowSummary" },
        "top_counterparties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "total"],
            "properties": {
              "name": { "type": "string" },
              "total": { "type": "string" }
            }
          }
        }
      }
    },
    "FlowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "total", "avg"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "total": { "type": "string" },
        "avg": { "type": "string" }
      }
    }
  }
}
