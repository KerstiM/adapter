{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/S-02_ml_projection_schema.json",
  "title": "ML projection row (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "row_id",
    "account_id",
    "record_id",
    "status",
    "value_date",
    "direction",
    "currency",
    "signed_amount",
    "abs_amount"
  ],
  "properties": {
    "row_id": {
      "type": "integer",
      "minimum": 1
    },
    "account_id": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "BOOKED",
        "PENDING"
      ]
    },
    "booking_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "value_date": {
      "type": "string",
      "format": "date"
    },
    "direction": {
      "type": "string",
      "enum": [
        "IN",
        "OUT"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "signed_amount": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,3})?$"
    },
    "abs_amount": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,3})?$"
    },
    "counterparty_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "remittance": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}