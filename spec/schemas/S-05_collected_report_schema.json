{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-05_collected_report_schema.json",
  "title": "CollectedReport v1",
  "type": "object",
  "required": ["report_schema_version", "run", "outcome", "summary", "issues", "metrics"],
  "properties": {
    "report_schema_version": { "type": "string", "minLength": 1 },

    "run": {
      "type": "object",
      "required": ["run_id", "created_at_utc", "adapter_version", "sv_schema_version", "mapping_version", "ruleset_version"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "sv_schema_version": { "type": "string", "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 },
        "ruleset_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },

    "outcome": {
      "type": "object",
      "required": ["status", "stop_reason"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL_SUCCESS", "FAIL"] },
        "stop_reason": { "type": "string" }
      },
      "additionalProperties": false
    },

    "summary": {
      "type": "object",
      "required": ["counts", "by_stage", "by_severity"],
      "properties": {
        "counts": {
          "type": "object",
          "required": ["accounts_total", "transactions_total", "transactions_emitted_sv", "transactions_dropped"],
          "properties": {
            "accounts_total": { "type": "integer", "minimum": 0 },
            "transactions_total": { "type": "integer", "minimum": 0 },
            "transactions_emitted_sv": { "type": "integer", "minimum": 0 },
            "transactions_dropped": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },

        "by_stage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "errors", "warnings", "infos"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": ["READ_INPUT", "STANDARDIZE_TO_SV", "VALIDATE_SCHEMA", "CHECK_INVARIANTS", "PROJECT_ML", "PROJECT_LLM", "WRITE_OUTPUTS"]
              },
              "errors": { "type": "integer", "minimum": 0 },
              "warnings": { "type": "integer", "minimum": 0 },
              "infos": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },

        "by_severity": {
          "type": "object",
          "required": ["CRITICAL", "ERROR", "WARN", "INFO"],
          "properties": {
            "CRITICAL": { "type": "integer", "minimum": 0 },
            "ERROR": { "type": "integer", "minimum": 0 },
            "WARN": { "type": "integer", "minimum": 0 },
            "INFO": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "stage", "message", "refs"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["CRITICAL", "ERROR", "WARN", "INFO"] },
          "stage": {
            "type": "string",
            "enum": ["READ_INPUT", "STANDARDIZE_TO_SV", "VALIDATE_SCHEMA", "CHECK_INVARIANTS", "PROJECT_ML", "PROJECT_LLM", "WRITE_OUTPUTS"]
          },
          "message": { "type": "string", "minLength": 1 },
          "refs": {
            "type": "object",
            "required": ["account_id", "record_id", "field_path", "source_lineage"],
            "properties": {
              "account_id": { "type": ["string", "null"] },
              "record_id": { "type": ["string", "null"] },
              "field_path": { "type": ["string", "null"] },
              "source_lineage": { "type": ["string", "null"] },
              "source_record_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },

    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "value", "method"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "null"] },
          "method": {
            "type": "object",
            "required": ["basis"],
            "properties": {
              "basis": { "type": "string" },
              "numerator": { "type": ["number", "null"] },
              "denominator": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
