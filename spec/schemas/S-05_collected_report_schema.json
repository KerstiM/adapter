{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-05_collected_report_schema.json",
  "version": "1.3.0",
  "title": "CollectedReport",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "report_schema_version",
    "run",
    "outcome",
    "summary",
    "run_flags",
    "issues",
    "dropped_details",
    "metrics"
  ],

  "properties": {
    "report_schema_version": { "type": "string", "const": "1.3.0" },

    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "created_at_utc",
        "profile_id",
        "dataset_id",
        "input_dir",
        "adapter_version",
        "sv_schema_version",
        "mapping_version",
        "ruleset_version"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },

        "profile_id": { "type": "string", "minLength": 1 },
        "dataset_id": { "type": "string", "minLength": 1 },
        "input_dir": { "type": "string", "minLength": 1 },

        "adapter_version": { "type": "string", "minLength": 1 },
        "sv_schema_version": { "type": "string", "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 },
        "ruleset_version": { "type": "string", "minLength": 1 },

        "spec_lock_sha256": { "type": "string", "minLength": 64 },
        "input_fingerprint": { "type": "string", "minLength": 8 }
      }
    },

    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stop_reason"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL_SUCCESS", "FAIL"] },
        "stop_reason": { "type": "string", "minLength": 1 }
      }
    },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "by_stage", "by_severity"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accounts_total",
            "transactions_total",
            "transactions_emitted_sv",
            "transactions_dropped",
            "ml_rows",
            "llm_contexts"
          ],
          "properties": {
            "accounts_total": { "type": "integer", "minimum": 0 },
            "transactions_total": { "type": "integer", "minimum": 0 },
            "transactions_emitted_sv": { "type": "integer", "minimum": 0 },
            "transactions_dropped": { "type": "integer", "minimum": 0 },
            "ml_rows": { "type": "integer", "minimum": 0 },
            "llm_contexts": { "type": "integer", "minimum": 0 }
          }
        },

        "by_stage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "errors", "warnings", "infos"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "READ_INPUT",
                  "STANDARDIZE_TO_SV",
                  "VALIDATE_SCHEMA",
                  "CHECK_INVARIANTS",
                  "PROJECT_ML",
                  "PROJECT_LLM",
                  "FORMAT_FOR_MODEL",
                  "WRITE_OUTPUTS"
                ]
              },
              "errors": { "type": "integer", "minimum": 0 },
              "warnings": { "type": "integer", "minimum": 0 },
              "infos": { "type": "integer", "minimum": 0 }
            }
          }
        },

        "by_severity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CRITICAL", "ERROR", "WARN", "INFO"],
          "properties": {
            "CRITICAL": { "type": "integer", "minimum": 0 },
            "ERROR": { "type": "integer", "minimum": 0 },
            "WARN": { "type": "integer", "minimum": 0 },
            "INFO": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "run_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["CRITICAL", "ERROR", "WARN", "INFO"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },

    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "stage", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["CRITICAL", "ERROR", "WARN", "INFO"] },
          "stage": {
            "type": "string",
            "enum": [
              "READ_INPUT",
              "STANDARDIZE_TO_SV",
              "VALIDATE_SCHEMA",
              "CHECK_INVARIANTS",
              "PROJECT_ML",
              "PROJECT_LLM",
              "WRITE_OUTPUTS"
            ]
          },
          "message": { "type": "string", "minLength": 1 },

          "refs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "account_id": { "type": ["string", "null"] },
              "record_id": { "type": ["string", "null"] },
              "field_path": { "type": ["string", "null"] },
              "source_lineage": { "type": ["string", "null"] }
            }
          }
        }
      }
    },

    "dropped_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_file", "input_path", "drop_reason"],
        "properties": {
          "source_file": { "type": ["string", "null"] },
          "input_path": { "type": ["string", "null"] },
          "transaction_id": { "type": ["string", "null"] },
          "record_id": { "type": ["string", "null"] },
          "drop_reason": { "type": "string", "minLength": 1 },
          "status": { "type": ["string", "null"], "enum": ["BOOKED", "PENDING", "INFORMATION", null] }
        }
      }
    },

    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sli1", "sli2", "qc2", "sli3", "gate", "info"],
      "properties": {
        "sli1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sli1_coverage_ratio", "priority_sv_fields_total", "covered_priority_sv_fields"],
          "properties": {
            "sli1_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "priority_sv_fields_total": { "type": "integer", "minimum": 0 },
            "covered_priority_sv_fields": { "type": "integer", "minimum": 0 }
          }
        },
        "sli2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validation_pass_through_ratio"],
          "properties": {
            "validation_pass_through_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "qc2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop_reporting_ratio", "all_drops_reported"],
          "properties": {
            "drop_reporting_ratio": { "type": "number", "minimum": 0 },
            "all_drops_reported": { "type": "boolean" }
          }
        },
        "sli3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invariant_compliance_ratio", "invariant_checked_total", "invariant_correct_total", "critical_invariant_violations_total"],
          "properties": {
            "invariant_compliance_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "invariant_checked_total": { "type": "integer", "minimum": 0 },
            "invariant_correct_total": { "type": "integer", "minimum": 0 },
            "critical_invariant_violations_total": { "type": "integer", "minimum": 0 }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_drop_ratio", "error_drops"],
          "properties": {
            "error_drop_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "error_drops": { "type": "integer", "minimum": 0 }
          }
        },
        "info": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ml_emission_ratio"],
          "properties": {
            "ml_emission_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },

    "output_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sv": { "type": "string", "minLength": 64 },
        "ml": { "type": "string", "minLength": 64 },
        "llm": { "type": "string", "minLength": 64 },
        "report": { "type": "string", "minLength": 64 }
      }
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    },

    "extra_projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled",
          "contract_id",
          "contract_version",
          "schema_id",
          "output_file",
          "item_count",
          "validation_result"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "contract_id": { "type": "string", "minLength": 1 },
          "contract_version": { "type": "string", "minLength": 1 },
          "schema_id": { "type": ["string", "null"] },
          "output_file": { "type": "string", "minLength": 1 },
          "item_count": { "type": "integer", "minimum": 0 },
          "validation_result": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}